{
  "name": "keboola/elasticsearch",
  "description": "PHP Client for Elasticsearch",
  "keywords": ["search","client", "elasticsearch"],
  "type": "library",
  "license": "Apache-2.0",
  "authors": [
    {
      "name": "Zachary Tong"
    }
  ],
  "require": {
    "php": "^8",
    "psr/log": "^3.0",
    "guzzlehttp/ringphp" : "~1.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^2",
    "symfony/yaml": "^5.0|^4.0",
    "symfony/finder": "^5.0|^4.0",
    "doctrine/inflector": "^2.0",
    "phpunit/phpunit": "^9.5",
    "mockery/mockery": "^1.5"
  },
  "suggest": {
    "ext-curl": "*",
    "monolog/monolog": "Allows for client-level logging and tracing"
  },
  "autoload": {
    "psr-4": {
      "KBC\\Elasticsearch\\": "src/Elasticsearch/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "KBC\\Elasticsearch\\Tests\\": "tests/Elasticsearch/Tests/"
    }
  }
}
